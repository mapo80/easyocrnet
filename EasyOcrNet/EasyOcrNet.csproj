<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0618;CS8619;CA1002;CA1010;CA1031;CA1034;CA1051;CA1054;CA1062;CA1063;CA1304;CA1305;CA1310;CA1508;CA1707;CA1710;CA1716;CA1720;CA1822;CA1852;CA2000;CA2007;CA2201;IDE0001;IDE0002;IDE0003;IDE0004;IDE0005;IDE0007;IDE0008;IDE0009;IDE0010;IDE0011;IDE0017;IDE0018;IDE0019;IDE0028;IDE0032;IDE0034;IDE0040;IDE0044;IDE0046;IDE0047;IDE0051;IDE0054;IDE0055;IDE0056;IDE0057;IDE0058;IDE0059;IDE0060;IDE0061;IDE0062;IDE0063;IDE0065;IDE0071;IDE0072;IDE0073;IDE0074;IDE0075;IDE0078;IDE0083;IDE0090;IDE0100;IDE0110;IDE0130;IDE0160;IDE0161;IDE0180;IDE0200;IDE0220;IDE0230;IDE0240;IDE0241;IDE0250;IDE0251;IDE0260;IDE0270;IDE0280;IDE0290;IDE1006</NoWarn>

    <!-- NuGet Package Settings -->
    <PackageId>EasyOcrNet</PackageId>
    <Version>1.0.1</Version>
    <Authors>EasyOcrNet</Authors>
    <Description>EasyOcrNet - .NET OCR library with ONNX models. Fast, lightweight optical character recognition for multiple languages without PyTorch dependencies. Includes CRAFT detection and CRNN recognition models.</Description>
    <PackageTags>ocr;onnx;easyocr;text-detection;text-recognition;craft;crnn</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/yourusername/easyocrnet</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- ONNX Runtime for model inference -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.0" />

    <!-- Image processing libraries -->
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.1" />

    <!-- SymSpell for spell checking -->
    <PackageReference Include="SymSpell" Version="6.7.2" />

    <!-- System libraries -->
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
    <PackageReference Include="System.Numerics.Tensors" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\character\*.txt">
      <Link>character\%(FileName)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

</Project>
