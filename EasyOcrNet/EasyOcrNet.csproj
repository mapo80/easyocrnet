<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- ONNX Runtime for model inference -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.17.0" />

    <!-- Image processing libraries -->
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.8" />

    <!-- SymSpell for spell checking -->
    <PackageReference Include="SymSpell" Version="6.7.2" />

    <!-- System libraries -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.Numerics.Tensors" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\character\*.txt">
      <Link>character\%(FileName)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

</Project>
