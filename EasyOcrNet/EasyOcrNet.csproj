<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- ONNX Runtime for model inference -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" />

    <!-- Image processing libraries -->
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.1" />

    <!-- SymSpell for spell checking -->
    <PackageReference Include="SymSpell" Version="6.7.3" />

    <!-- System libraries -->
    <PackageReference Include="System.Text.Json" Version="9.0.10" />
    <PackageReference Include="System.Numerics.Tensors" Version="9.0.10" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\character\*.txt">
      <Link>character\%(FileName)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

</Project>
