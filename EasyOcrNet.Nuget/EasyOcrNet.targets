<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <!-- Copy ONNX models to output directory -->
    <Content Include="$(MSBuildThisFileDirectory)..\contentFiles\any\any\models\*.*">
      <Link>models\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>

    <!-- Copy character files to output directory -->
    <Content Include="$(MSBuildThisFileDirectory)..\contentFiles\any\any\character\*.*">
      <Link>character\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
